{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SourceData_Bank",
						"type": "DatasetReference"
					},
					"name": "SourceCustomer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sinkData_Bank",
						"type": "DatasetReference"
					},
					"name": "Destcustomer"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     timestamp_lookup as string",
				"}",
				"source(output(",
				"          customer_id as string,",
				"          operation_type as string,",
				"          before_image as string,",
				"          after_image as string,",
				"          commit_timestamp as string,",
				"          sequence_number as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SourceCustomer",
				"SourceCustomer filter(toTimestamp(commit_timestamp)>toTimestamp($timestamp_lookup)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Destcustomer"
			]
		}
	}
}