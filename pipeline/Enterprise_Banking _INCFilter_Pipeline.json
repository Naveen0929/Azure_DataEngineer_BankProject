{
	"name": "Enterprise_Banking _INCFilter_Pipeline",
	"properties": {
		"activities": [
			{
				"name": "LOOKUP_watermrk_SQLtable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqltoADF",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Get Metadata_Of _Landinglayer",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "Adls_fileslist",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Filter_CDC_Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get Metadata_Of _Landinglayer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "LOOKUP_watermrk_SQLtable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata_Of _Landinglayer').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(\n    startswith(item().name,'customer_cdc'),\n    endswith(item().name,'.csv' )\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach_Loop_CDCFiles",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter_CDC_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter_CDC_Files').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Get Metadata_SinkFiles",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "Bronze_files_checklist",
									"type": "DatasetReference",
									"parameters": {
										"Filename": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						},
						{
							"name": "If Condition_toCheck _Fileexistin_sink",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get Metadata_SinkFiles",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@activity('Get Metadata_SinkFiles').output.exists",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Data flow_filter",
										"description": "Filter the rows> watermark time stamp which is output of lookup",
										"type": "ExecuteDataFlow",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataflow": {
												"referenceName": "dataflow2",
												"type": "DataFlowReference",
												"parameters": {
													"Lookup_Timestamp": {
														"value": "'@{string(activity('LOOKUP_watermrk_SQLtable').output.firstRow.last_commit_timestamp)}'",
														"type": "Expression"
													},
													"Output_filename": {
														"value": "'@{item().name}'",
														"type": "Expression"
													}
												},
												"datasetParameters": {
													"SorceCustomer": {
														"Main_Folder": "landing-layer",
														"Filename": {
															"value": "@item().name",
															"type": "Expression"
														}
													},
													"sink1": {
														"Folder_name": "customer_cdc",
														"File_name": "@item().name"
													}
												}
											},
											"compute": {
												"coreCount": 8,
												"computeType": "General"
											},
											"traceLevel": "Fine"
										}
									},
									{
										"name": "Copy from sink to sql table",
										"description": "inserting the data into the CustomerCdcStage table",
										"type": "Copy",
										"dependsOn": [
											{
												"activity": "Data flow_filter",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "AzureSqlSink",
												"writeBehavior": "insert",
												"sqlWriterUseTableLock": false
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "sinkData_Bank",
												"type": "DatasetReference",
												"parameters": {
													"Folder_name": "customer_cdc",
													"File_name": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ADF_to_sql",
												"type": "DatasetReference"
											}
										]
									},
									{
										"name": "Stored procedure1_copy1_copy1",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy from sink to sql table",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_ApplyCustomerCDC]"
										},
										"linkedServiceName": {
											"referenceName": "Sql_to_ADF_EntraID",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Watermark update SP",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "ForEach_Loop_CDCFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_updatewatermark]",
					"storedProcedureParameters": {
						"run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "Sql_to_ADF_EntraID",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": []
	}
}