{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AzureDataFactory-Bank"
		},
		"Adls_bank_storage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://bankdataanalysis.dfs.core.windows.net/"
		},
		"Sql_to_ADF_EntraID_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-bank-server.database.windows.net"
		},
		"Sql_to_ADF_EntraID_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-bank"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AzureDataFactory-Bank_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Adls_bank_storage_properties_typeProperties_url": {
						"value": "[parameters('Adls_bank_storage_properties_typeProperties_url')]"
					},
					"Sql_to_ADF_EntraID_properties_typeProperties_server": {
						"value": "[parameters('Sql_to_ADF_EntraID_properties_typeProperties_server')]"
					},
					"Sql_to_ADF_EntraID_properties_typeProperties_database": {
						"value": "[parameters('Sql_to_ADF_EntraID_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}